{
  "schemaVersion": 1,
  "id": "flow-spec",
  "title": "Intent Spec",
  "journal": "ledger-only",
  "change": "new",
  "entry": "init",
  "maxTransitions": 100,
  "roles": [
    "deriver",
    "developer",
    "reviewer"
  ],
  "nodes": {
    "init": {
      "kind": "assign",
      "params": {
        "set": {
          "derivationRepairs": 0,
          "correctionRounds": 0,
          "correctionLimit": 2,
          "latestFindings": "",
          "tagReport": ""
        }
      },
      "ends": {
        "next": "derive",
        "failed": "failed"
      }
    },
    "derive": {
      "kind": "derive-change",
      "params": {
        "change": "{{run.changeId}}",
        "summaryPath": "flow-summary.md",
        "feedback": "{{run.latestFindings}}"
      },
      "ends": {
        "pass": "tag",
        "fail": "repair-guard"
      }
    },
    "tag": {
      "kind": "role-turn",
      "params": {
        "roleId": "developer",
        "stance": "fixer",
        "artifacts": "test-evidence",
        "prompt": "Tag the existing tests of change {{run.changeId}} with the requirements they demonstrate: for every ADDED or MODIFIED requirement of its delta specs, add [spec:<capability>/<requirement-slug>] to the titles of the tests that demonstrate it (or a spec: comment on the line before the test). For a requirement no existing test demonstrates, add one focused test of its observable behaviour, tagged with its id, in a test file that already differs from the base. Then update the change's tasks.md and design.md: their test evidence cites the tests you tagged or added, and the files the change touches include every test file you changed. Change nothing else under openspec/, no production code, no existing assertion, and never expand scope. Run every test file you touched, in full. List under incomplete a requirement you could not demonstrate, and every test that fails, with the command you ran and its error. Return summary and incomplete.",
        "structuredOutput": {
          "type": "object",
          "required": [
            "summary",
            "incomplete"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "incomplete": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sessionContinuity": "none"
      },
      "ends": {
        "next": "tag-report",
        "invalid": "check",
        "failed": "failed"
      }
    },
    "tag-report": {
      "kind": "assign",
      "params": {
        "set": {
          "tagReport": "{{outputs.tag.structured}}"
        }
      },
      "ends": {
        "next": "check",
        "failed": "failed"
      }
    },
    "repair-guard": {
      "kind": "condition",
      "params": {
        "expr": "$vars.derivationRepairs < 1"
      },
      "ends": {
        "true": "repair-count",
        "false": "failed"
      }
    },
    "repair-count": {
      "kind": "assign",
      "params": {
        "increment": {
          "derivationRepairs": 1
        }
      },
      "ends": {
        "next": "derive",
        "failed": "failed"
      }
    },
    "check": {
      "kind": "verify",
      "params": {
        "commands": "configured",
        "additionalCommandsFrom": "derive",
        "setup": "configured"
      },
      "ends": {
        "pass": "review",
        "fail": "check-findings",
        "failed": "failed"
      }
    },
    "check-findings": {
      "kind": "assign",
      "params": {
        "set": {
          "latestFindings": "Host verification failed for the current candidate: {{outputs.check}}"
        }
      },
      "ends": {
        "next": "correction-budget",
        "failed": "failed"
      }
    },
    "review": {
      "kind": "role-turn",
      "params": {
        "roleId": "reviewer",
        "prompt": "Review the derived OpenSpec change against the code that already exists, the verification evidence and the derivation coverage report. The tag step ran the change's tests and reported: {{run.tagReport}}. A failing test it lists is a failing check. What the person asked for or decided during the Intent session is requested scope: never ask to revert it. List each change no request or decision supports under unrequested, for the person to decide.",
        "structuredOutput": {
          "type": "object",
          "required": [
            "approved",
            "issues",
            "unrequested"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unrequested": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ends": {
        "next": "review-policy",
        "invalid": "failed",
        "failed": "failed"
      }
    },
    "review-policy": {
      "kind": "condition",
      "params": {
        "expr": "$outputs.review.structured.approved == true && !exists($outputs.review.structured.unrequested.0)"
      },
      "ends": {
        "true": "archive",
        "false": "review-findings"
      }
    },
    "review-findings": {
      "kind": "assign",
      "params": {
        "set": {
          "latestFindings": "{{outputs.review.structured}}"
        }
      },
      "ends": {
        "next": "scope-gate",
        "failed": "failed"
      }
    },
    "scope-gate": {
      "kind": "condition",
      "params": {
        "expr": "exists($outputs.review.structured.unrequested.0)"
      },
      "ends": {
        "true": "scope-decision",
        "false": "correction-budget"
      }
    },
    "correction-budget": {
      "kind": "condition",
      "params": {
        "expr": "$vars.correctionRounds < $vars.correctionLimit"
      },
      "ends": {
        "true": "begin-correction",
        "false": "changes-requested"
      }
    },
    "begin-correction": {
      "kind": "assign",
      "params": {
        "increment": {
          "correctionRounds": 1
        },
        "set": {
          "derivationRepairs": 0,
          "tagReport": ""
        }
      },
      "ends": {
        "next": "fix",
        "failed": "failed"
      }
    },
    "fix": {
      "kind": "role-turn",
      "params": {
        "roleId": "developer",
        "stance": "fixer",
        "prompt": "Correct the code the Intent session built for change {{run.changeId}} so the findings below are resolved. Fix every defect they name. Add or extend the tests they ask for (new test files are allowed for that) and tag each test that demonstrates an ADDED or MODIFIED requirement with [spec:<capability>/<requirement-slug>]. Never expand the scope beyond the findings. Never edit openspec/: Core re-derives the OpenSpec change from the code after this turn. Never revert behaviour: what the person asked for in the Intent session is in scope, and whether to keep a change nobody asked for is the person's decision; list such a finding under incomplete. Return summary and incomplete.\n\nFindings:\n{{run.latestFindings}}",
        "structuredOutput": {
          "type": "object",
          "required": [
            "summary",
            "incomplete"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "incomplete": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sessionContinuity": "none"
      },
      "ends": {
        "next": "fix-progress",
        "invalid": "failed",
        "failed": "failed"
      }
    },
    "fix-progress": {
      "kind": "condition",
      "params": {
        "expr": "exists($outputs.fix.candidateHash) && $outputs.fix.candidateHash != null && $outputs.fix.candidateHash != $outputs.check.candidateHash"
      },
      "ends": {
        "true": "derive",
        "false": "derive"
      }
    },
    "archive": {
      "kind": "openspec-archive",
      "params": {
        "change": "{{run.changeId}}",
        "requiresVerified": true
      },
      "ends": {
        "next": "verify",
        "failed": "failed"
      }
    },
    "verify": {
      "kind": "verify",
      "params": {
        "commands": "configured",
        "additionalCommandsFrom": "derive",
        "setup": "configured"
      },
      "ends": {
        "pass": "done",
        "fail": "failed",
        "failed": "failed"
      }
    },
    "done": {
      "kind": "end",
      "params": {
        "outcome": "success",
        "requiresVerified": true
      },
      "ends": {}
    },
    "failed": {
      "kind": "end",
      "params": {
        "outcome": "failure"
      },
      "ends": {}
    },
    "changes-requested": {
      "kind": "end",
      "params": {
        "outcome": "failure",
        "reason": "Intent → Spec: the reviewer requested changes that {{run.correctionRounds}} correction round(s) did not resolve. Latest findings: {{run.latestFindings}}"
      },
      "ends": {}
    },
    "scope-decision": {
      "kind": "end",
      "params": {
        "outcome": "failure",
        "reason": "Intent → Spec: the review found changes that no request or decision of the Intent session supports; the person decides whether to keep them as requirements or revert them. Latest findings: {{run.latestFindings}}"
      },
      "ends": {}
    }
  },
  "version": "26970f2c837941b81d36534b67cc1d85eca9355c7f65d02c6b89698dffd21f8b"
}
