{
  "schemaVersion": 1,
  "id": "flow-spec",
  "title": "Flow Spec",
  "journal": "ledger-only",
  "change": "new",
  "entry": "init",
  "maxTransitions": 100,
  "roles": [
    "deriver",
    "developer",
    "reviewer"
  ],
  "nodes": {
    "init": {
      "kind": "assign",
      "params": {
        "set": {
          "derivationRepairs": 0,
          "correctionRounds": 0,
          "correctionLimit": 2,
          "latestFindings": ""
        }
      },
      "ends": {
        "next": "derive",
        "failed": "failed"
      }
    },
    "derive": {
      "kind": "derive-change",
      "params": {
        "change": "{{run.changeId}}",
        "summaryPath": "flow-summary.md",
        "feedback": "{{run.latestFindings}}"
      },
      "ends": {
        "pass": "check",
        "fail": "repair-guard"
      }
    },
    "repair-guard": {
      "kind": "condition",
      "params": {
        "expr": "$vars.derivationRepairs < 1"
      },
      "ends": {
        "true": "repair-count",
        "false": "failed"
      }
    },
    "repair-count": {
      "kind": "assign",
      "params": {
        "increment": {
          "derivationRepairs": 1
        }
      },
      "ends": {
        "next": "derive",
        "failed": "failed"
      }
    },
    "check": {
      "kind": "verify",
      "params": {
        "commands": "configured",
        "additionalCommandsFrom": "derive"
      },
      "ends": {
        "pass": "review",
        "fail": "check-findings",
        "failed": "failed"
      }
    },
    "check-findings": {
      "kind": "assign",
      "params": {
        "set": {
          "latestFindings": "Host verification failed for the current candidate: {{outputs.check}}"
        }
      },
      "ends": {
        "next": "correction-budget",
        "failed": "failed"
      }
    },
    "review": {
      "kind": "role-turn",
      "params": {
        "roleId": "reviewer",
        "prompt": "Review the derived OpenSpec change against the code that already exists, the verification evidence and the derivation coverage report.",
        "structuredOutput": {
          "type": "object",
          "required": [
            "approved",
            "issues"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ends": {
        "next": "review-policy",
        "invalid": "failed",
        "failed": "failed"
      }
    },
    "review-policy": {
      "kind": "condition",
      "params": {
        "expr": "$outputs.review.structured.approved == true"
      },
      "ends": {
        "true": "archive",
        "false": "review-findings"
      }
    },
    "review-findings": {
      "kind": "assign",
      "params": {
        "set": {
          "latestFindings": "{{outputs.review.structured}}"
        }
      },
      "ends": {
        "next": "correction-budget",
        "failed": "failed"
      }
    },
    "correction-budget": {
      "kind": "condition",
      "params": {
        "expr": "$vars.correctionRounds < $vars.correctionLimit"
      },
      "ends": {
        "true": "begin-correction",
        "false": "changes-requested"
      }
    },
    "begin-correction": {
      "kind": "assign",
      "params": {
        "increment": {
          "correctionRounds": 1
        },
        "set": {
          "derivationRepairs": 0
        }
      },
      "ends": {
        "next": "fix",
        "failed": "failed"
      }
    },
    "fix": {
      "kind": "role-turn",
      "params": {
        "roleId": "developer",
        "stance": "fixer",
        "prompt": "Correct the code Flow built for change {{run.changeId}} so the findings below are resolved. Fix every defect they name. Add or extend the tests they ask for (new test files are allowed for that) and tag each test that demonstrates an ADDED or MODIFIED requirement with [spec:<capability>/<requirement-slug>]. Never expand the scope beyond the findings. Never edit openspec/: Core re-derives the OpenSpec change from the code after this turn. Revert code only when a finding says it is unrequested AND it contradicts a stated Non-Goal. Return summary and incomplete.\n\nFindings:\n{{run.latestFindings}}",
        "structuredOutput": {
          "type": "object",
          "required": [
            "summary",
            "incomplete"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "incomplete": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sessionContinuity": "none"
      },
      "ends": {
        "next": "fix-progress",
        "invalid": "failed",
        "failed": "failed"
      }
    },
    "fix-progress": {
      "kind": "condition",
      "params": {
        "expr": "exists($outputs.fix.candidateHash) && $outputs.fix.candidateHash != null && $outputs.fix.candidateHash != $outputs.check.candidateHash"
      },
      "ends": {
        "true": "derive",
        "false": "changes-requested"
      }
    },
    "archive": {
      "kind": "openspec-archive",
      "params": {
        "change": "{{run.changeId}}",
        "requiresVerified": true
      },
      "ends": {
        "next": "verify",
        "failed": "failed"
      }
    },
    "verify": {
      "kind": "verify",
      "params": {
        "commands": "configured",
        "additionalCommandsFrom": "derive"
      },
      "ends": {
        "pass": "done",
        "fail": "failed",
        "failed": "failed"
      }
    },
    "done": {
      "kind": "end",
      "params": {
        "outcome": "success",
        "requiresVerified": true
      },
      "ends": {}
    },
    "failed": {
      "kind": "end",
      "params": {
        "outcome": "failure"
      },
      "ends": {}
    },
    "changes-requested": {
      "kind": "end",
      "params": {
        "outcome": "failure",
        "reason": "Flow → Spec: the reviewer requested changes that {{run.correctionRounds}} correction round(s) did not resolve. Latest findings: {{run.latestFindings}}"
      },
      "ends": {}
    }
  },
  "version": "4434e9a51f42e2d93762c7d3539c00f3f2102c064e107c636f6bb261221b5b44"
}
