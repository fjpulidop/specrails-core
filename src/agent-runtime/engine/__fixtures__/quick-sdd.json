{
  "schemaVersion": 1,
  "id": "quick-sdd",
  "title": "Quick Sdd",
  "journal": "ledger-only",
  "change": "new",
  "entry": "work",
  "maxTransitions": 100,
  "roles": [],
  "nodes": {
    "work": {
      "kind": "prompt",
      "params": {
        "engine": {
          "provider": "fixture"
        },
        "nativeCommand": {
          "id": "opsx:ff",
          "args": "{{run.changeId}}"
        },
        "access": "write",
        "sentinel": "blocked"
      },
      "ends": {
        "next": "validate",
        "failed": "failed",
        "blocked": "failed"
      }
    },
    "validate": {
      "kind": "openspec-validate",
      "params": {
        "change": "{{run.changeId}}"
      },
      "ends": {
        "pass": "apply",
        "fail": "failed",
        "failed": "failed"
      }
    },
    "apply": {
      "kind": "prompt",
      "params": {
        "engine": {
          "provider": "fixture"
        },
        "nativeCommand": {
          "id": "opsx:apply",
          "args": "{{run.changeId}}"
        },
        "access": "write",
        "sentinel": "blocked"
      },
      "ends": {
        "next": "check",
        "failed": "failed",
        "blocked": "failed"
      }
    },
    "check": {
      "kind": "verify",
      "params": {
        "commands": "configured"
      },
      "ends": {
        "pass": "archive",
        "fail": "failed",
        "failed": "failed"
      }
    },
    "archive": {
      "kind": "openspec-archive",
      "params": {
        "change": "{{run.changeId}}"
      },
      "ends": {
        "next": "verify",
        "failed": "failed"
      }
    },
    "verify": {
      "kind": "verify",
      "params": {
        "commands": "configured"
      },
      "ends": {
        "pass": "done",
        "fail": "failed",
        "failed": "failed"
      }
    },
    "done": {
      "kind": "end",
      "params": {
        "outcome": "success",
        "requiresVerified": true
      },
      "ends": {}
    },
    "failed": {
      "kind": "end",
      "params": {
        "outcome": "failure"
      },
      "ends": {}
    }
  },
  "version": "883ccb470eabea1d8228a4ad1f3cc4a513d64372e1a2027c79bcfe2432f392bf"
}
